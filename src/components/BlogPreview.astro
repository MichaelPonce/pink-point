---
import { ArrowRight, CalendarDays } from 'lucide-react';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const dateFormat = new Intl.DateTimeFormat('es-NI', { day: 'numeric', month: 'short', year: 'numeric' });
---

<section id="blog" class="scroll-mt-24 space-y-7 py-8">
  <div class="flex flex-col gap-3 border-b border-slate-200 pb-5 dark:border-slate-800 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="code-font text-xs uppercase text-sky-700 dark:text-sky-400">Notas de ingeniería</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-950 dark:text-white">Blog técnico</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">Soluciones y aprendizajes sobre bases de datos, CI/CD y desarrollo móvil.</p>
    </div>
    <a class="inline-flex items-center gap-2 text-sm font-semibold text-sky-700 hover:text-sky-600 dark:text-sky-400" href="/blog/">Todos los artículos <ArrowRight size={16} aria-hidden="true" /></a>
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    {posts.map((post) => (
      <article class="flex min-h-56 flex-col justify-between border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
        <div>
          <div class="flex items-center gap-2 text-xs text-slate-500"><CalendarDays size={14} aria-hidden="true" /><time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time></div>
          <h3 class="mt-4 text-lg font-bold leading-snug text-slate-950 dark:text-white"><a class="hover:text-emerald-700 dark:hover:text-emerald-400" href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{post.data.description}</p>
        </div>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Temas">
          {post.data.tags.slice(0, 3).map((tag) => <li class="code-font border border-slate-200 px-2 py-1 text-[11px] text-slate-500 dark:border-slate-700 dark:text-slate-400">{tag}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
