---
import { ArrowUpRight, Mail } from 'lucide-react';
---

<section id="contacto" class="scroll-mt-24 border-y border-slate-200 bg-sky-50/70 px-5 py-10 dark:border-slate-800 dark:bg-slate-900/50 sm:px-8 sm:py-12">
  <div class="mx-auto grid max-w-7xl gap-6 md:grid-cols-[1fr_auto] md:items-center">
    <div class="max-w-2xl">
      <p class="code-font text-xs uppercase text-sky-700 dark:text-sky-400">Colaboración</p>
      <h2 class="mt-2 text-3xl font-bold text-slate-950 dark:text-white">¿Tienes un proyecto en mente?</h2>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">Hablemos sobre backend .NET, bases de datos, automatización de entregas o aplicaciones Android.</p>
    </div>
    <a class="inline-flex min-h-12 items-center justify-center gap-2 rounded-md bg-slate-950 px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-slate-800 dark:bg-emerald-500 dark:text-slate-950 dark:hover:bg-emerald-400" href="mailto:contacto@michaelponcedev.com">
      <Mail size={16} aria-hidden="true" /> Escribir por correo <ArrowUpRight size={15} aria-hidden="true" />
    </a>
  </div>
</section>
