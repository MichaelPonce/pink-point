---
import { Database, GitBranch, Server } from 'lucide-react';

const services = [
  {
    title: 'Backend y APIs',
    description: 'Diseño de APIs REST y servicios .NET preparados para operar con seguridad, observabilidad y crecimiento.',
    points: ['ASP.NET Core', 'Autenticación y autorización', 'Integraciones de servicios'],
    Icon: Server,
    iconClass: 'bg-sky-500/10 text-sky-700 dark:text-sky-400',
  },
  {
    title: 'Datos y rendimiento',
    description: 'Modelado relacional y optimización de consultas para que el acceso a los datos sea rápido y predecible.',
    points: ['SQL Server y PostgreSQL', 'Índices y procedimientos', 'Migración y calidad de datos'],
    Icon: Database,
    iconClass: 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-400',
  },
  {
    title: 'CI/CD y nube',
    description: 'Pipelines reproducibles que reducen trabajo manual y entregan cambios con verificaciones consistentes.',
    points: ['Azure DevOps y GitHub Actions', 'Automatización de despliegues', 'Configuración de entornos'],
    Icon: GitBranch,
    iconClass: 'bg-amber-500/10 text-amber-700 dark:text-amber-400',
  },
];
---

<section id="servicios" class="scroll-mt-24 space-y-7 py-8">
  <div class="border-b border-slate-200 pb-5 dark:border-slate-800">
    <p class="code-font text-xs uppercase text-sky-700 dark:text-sky-400">Consultoría e ingeniería</p>
    <h2 class="mt-2 text-3xl font-bold text-slate-950 dark:text-white">Servicios</h2>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">Construcción y mejora de productos, desde la arquitectura backend hasta el despliegue.</p>
  </div>
  <div class="grid gap-4 md:grid-cols-3">
    {services.map(({ title, description, points, Icon, iconClass }) => (
      <article class="border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 sm:p-6">
        <div class:list={["grid size-11 place-items-center", iconClass]}>
          <Icon size={21} aria-hidden="true" />
        </div>
        <h3 class="mt-4 text-lg font-bold text-slate-950 dark:text-white">{title}</h3>
        <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{description}</p>
        <ul class="mt-5 space-y-2 border-t border-slate-100 pt-4 text-sm text-slate-700 dark:border-slate-800 dark:text-slate-300">
          {points.map((point) => <li class="flex gap-2"><span class="text-emerald-600 dark:text-emerald-400" aria-hidden="true">✓</span>{point}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
