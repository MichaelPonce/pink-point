---
import { FileText, Menu } from 'lucide-react';
import ThemeToggle from './react/ThemeToggle.tsx';

const links = [
  { href: '/#inicio', label: 'Inicio' },
  { href: '/#apps', label: 'Apps' },
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#experiencia', label: 'Trayectoria' },
  { href: '/blog/', label: 'Blog' },
];
---

<header class="site-header sticky top-0 z-40 border-b border-slate-200/80 bg-slate-50/90 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/90">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/#inicio" class="flex shrink-0 items-center gap-2" aria-label="Michael Ponce, inicio">
      <span class="grid size-9 place-items-center rounded-lg bg-emerald-500 font-bold text-slate-950">MP</span>
      <span class="font-bold">MichaelPonce<span class="code-font text-emerald-600 dark:text-emerald-400">.dev</span></span>
    </a>

    <nav class="hidden items-center gap-6 text-sm text-slate-600 dark:text-slate-300 md:flex" aria-label="Navegación principal">
      {links.map((link) => <a class="transition-colors hover:text-emerald-600 dark:hover:text-emerald-400" href={link.href}>{link.label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <button class="hidden items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold transition-colors hover:border-emerald-500 dark:border-slate-700 sm:inline-flex" type="button" data-cv-open>
        <FileText size={16} aria-hidden="true" /> CV
      </button>
      <a class="hidden rounded-md bg-emerald-500 px-3 py-2 text-sm font-semibold text-slate-950 transition-colors hover:bg-emerald-400 sm:inline-flex" href="/#contacto">Contactar</a>
      <details class="relative md:hidden">
        <summary class="grid size-10 cursor-pointer list-none place-items-center rounded-md border border-slate-300 dark:border-slate-700" aria-label="Abrir navegación">
          <Menu size={18} aria-hidden="true" />
        </summary>
        <nav class="absolute right-0 top-12 z-50 grid min-w-48 gap-1 border border-slate-200 bg-white p-2 shadow-lg dark:border-slate-700 dark:bg-slate-900" aria-label="Navegación móvil">
          {links.map((link) => <a class="rounded px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" href={link.href}>{link.label}</a>)}
          <a class="rounded px-3 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" href="/#contacto">Contacto</a>
          <button class="rounded px-3 py-2 text-left text-sm hover:bg-slate-100 dark:hover:bg-slate-800" type="button" data-cv-open>Ver CV</button>
        </nav>
      </details>
    </div>
  </div>
</header>
