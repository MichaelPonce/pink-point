---
import { ArrowRight, ChevronLeft } from 'lucide-react';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layout/BaseLayout.astro';

const posts = (await getCollection('blog')).sort((left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf());
const dateFormat = new Intl.DateTimeFormat('es-NI', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Blog técnico | MichaelPonceDev.com" description="Artículos sobre SQL Server, Azure DevOps, Android y publicación en Google Play.">
  <main class="mx-auto max-w-7xl space-y-8 px-4 py-10 sm:px-6 lg:px-8">
    <a class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400" href="/#blog"><ChevronLeft size={16} aria-hidden="true" /> Inicio</a>
    <header class="max-w-3xl border-b border-slate-200 pb-6 dark:border-slate-800">
      <p class="code-font text-xs uppercase text-sky-700 dark:text-sky-400">Notas de ingeniería</p>
      <h1 class="mt-2 text-4xl font-bold text-slate-950 dark:text-white">Blog técnico</h1>
      <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-400">Guías prácticas basadas en problemas reales de datos, automatización y desarrollo móvil.</p>
    </header>

    <div class="grid gap-4 md:grid-cols-2">
      {posts.map((post) => (
        <article class="border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900 sm:p-6">
          <time class="code-font text-xs text-slate-500" datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
          <h2 class="mt-3 text-xl font-bold leading-snug text-slate-950 dark:text-white"><a class="hover:text-emerald-700 dark:hover:text-emerald-400" href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
          <p class="mt-2 text-sm leading-6 text-slate-600 dark:text-slate-400">{post.data.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Temas">
            {post.data.tags.map((tag) => <li class="code-font border border-slate-200 px-2 py-1 text-[11px] text-slate-500 dark:border-slate-700 dark:text-slate-400">{tag}</li>)}
          </ul>
          <a class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-sky-700 dark:text-sky-400" href={`/blog/${post.id}/`}>Leer artículo <ArrowRight size={15} aria-hidden="true" /></a>
        </article>
      ))}
    </div>

    <aside class="border-l-2 border-emerald-500 bg-slate-100 p-5 dark:bg-slate-900">
      <h2 class="font-semibold text-slate-900 dark:text-slate-100">También puede interesarte</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Conoce las <a class="underline underline-offset-4 hover:text-emerald-600" href="/#apps">aplicaciones Android</a> y consulta la <a class="underline underline-offset-4 hover:text-emerald-600" href="/legal/privacidad-taskflow/">política de privacidad de TaskFlow Pro</a>.</p>
    </aside>
  </main>
</BaseLayout>
