<dialog id="cv-dialog" class="m-auto w-[min(92vw,34rem)] border border-slate-200 bg-white p-0 text-slate-900 shadow-2xl backdrop:bg-slate-950/70 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100">
  <div class="space-y-5 p-6 sm:p-8">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="code-font text-xs uppercase text-emerald-600 dark:text-emerald-400">Perfil profesional</p>
        <h2 class="mt-2 text-2xl font-bold">Michael Ponce</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">Ingeniero de Software · Backend & Mobile</p>
      </div>
      <button class="rounded-md border border-slate-300 px-3 py-2 text-sm dark:border-slate-700" type="button" data-cv-close aria-label="Cerrar diálogo">Cerrar</button>
    </div>
    <div class="space-y-3 border-y border-slate-200 py-4 text-sm leading-6 text-slate-700 dark:border-slate-700 dark:text-slate-300">
      <p><strong>Stack:</strong> .NET, C#, SQL Server, PostgreSQL, Azure DevOps y Android.</p>
      <p><strong>Enfoque:</strong> APIs y sistemas de datos de alto rendimiento, automatización y publicación de aplicaciones móviles.</p>
      <p><strong>Experiencia:</strong> digitalización de procesos, desarrollo de producto y soporte de infraestructura.</p>
    </div>
    <div class="flex flex-wrap justify-end gap-3">
      <button class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold dark:border-slate-700" type="button" data-cv-close>Seguir en el sitio</button>
      <a class="rounded-md bg-emerald-500 px-4 py-2 text-sm font-semibold text-slate-950 hover:bg-emerald-400" href="/cv/">Ver CV e imprimir</a>
    </div>
  </div>
</dialog>

<script>
  const cvDialog = document.querySelector<HTMLDialogElement>('#cv-dialog');

  document.querySelectorAll<HTMLButtonElement>('[data-cv-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => cvDialog?.showModal());
  });

  cvDialog?.querySelectorAll<HTMLButtonElement>('[data-cv-close]').forEach((button) => {
    button.addEventListener('click', () => cvDialog.close());
  });

  cvDialog?.addEventListener('click', (event) => {
    if (event.target === cvDialog) cvDialog.close();
  });
</script>
