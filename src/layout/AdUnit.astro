---
interface Props {
  slotId: string;
  format?: 'auto' | 'fluid' | 'rectangle';
}
const { slotId, format = 'auto' } = Astro.props;
---

<div class="w-full min-h-[90px] bg-slate-100 dark:bg-slate-900/40 border border-dashed border-slate-300 dark:border-slate-800 rounded-xl flex items-center justify-center my-8 overflow-hidden">
  <ins class="adsbygoogle"
       style="display:block; width:100%;"
       data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
       data-ad-slot={slotId}
       data-ad-format={format}
       data-full-width-responsive="true"></ins>
  <script is:inline>
       (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>